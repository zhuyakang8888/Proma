# 内部平台接口配置模板（两个系统各自独立）
#
# 登录已改为交互式：凭据由用户在运行时提供，通过命令行参数传入，不预置在这里。
# 本文件只用来预置**接口地址**（地址不是密钥，预置可减少来回问答）。
#
# 复制为 ~/.proma/.internal-platform-api.env（仓库之外，推荐），
# 或技能目录下的 .env.local（已被 .gitignore 忽略，仅供本地联调）。
# 也可改用进程环境变量，命名规则同样是 SM_<系统ID大写>_<字段>。
#
# 命令行参数优先级高于本文件，所以临时联调时直接加 --base-url 即可，无需改这里。

# ---------- social：前台系统 / 社媒矩阵运营平台 ----------
SM_SOCIAL_BASE_URL=

# ---------- admin：后台系统 / 运营管理后台 ----------
SM_ADMIN_BASE_URL=

# ---------- 以下为可选：仅在不想每次交互输入时才填写 ----------
# 前台登录凭据（对应 POST /auth/app/login 的 App-Key 与 App-Secret 请求头）
SM_SOCIAL_APP_KEY=
SM_SOCIAL_APP_SECRET=
# 账号密码：一般留空，由用户交互提供。若填写，注意本文件不要提交进仓库。
SM_SOCIAL_USERNAME=
SM_SOCIAL_PASSWORD=

# 后台登录端点未知（导出里没有登录接口）。首次联调确认后填在这里，
# 或临时用 --login-path 传入。必要时再用 --login-method、--token-path 修正。
SM_ADMIN_LOGIN_PATH=
